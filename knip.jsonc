{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  // Figma loads the dev plugin's code; pbpaste is macOS's clipboard command.
  "ignore": ["figma/plugin/code.js"],
  "ignoreBinaries": ["pbpaste"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
    },
    "packages/engine": {
      "entry": ["src/index.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
    },
    "tokens": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
    },
    "apps/storybook": {
      "entry": [".storybook/*.{ts,tsx}", "src/**/*.stories.tsx"],
      // Imported by src/styles.css (@import 'tailwindcss'), which knip does not read.
      "ignoreDependencies": ["tailwindcss"],
      "project": ["src/**/*.{ts,tsx}", ".storybook/*.{ts,tsx}"],
    },
    "apps/docs": {
      "entry": ["lib/**/*.test.ts", "scripts/*.mjs"],
      // Imported by app/globals.css (@import 'tailwindcss'), which knip does not read.
      "ignoreDependencies": ["tailwindcss"],
      "project": ["app/**/*.{ts,tsx}", "components/**/*.tsx", "lib/**/*.ts"],
    },
  },
}
