{
  "$description": "The Linear visual theme (PRD FR-V1 to FR-V5, FR-V9, FR-V12) and nimki's colour extensions. A token's value is light mode; dark is a mode. Colours are OKLCH.",
  "color": {
    "$type": "color",
    "$description": "shadcn's variables, written to CSS under their shadcn names so a project can replace any of them. In the Linear theme each points at a step of the neutral ramp, except popover and destructive.",
    "background": {
      "$value": "{ramp.neutral.1}"
    },
    "foreground": {
      "$value": "{ramp.neutral.12}"
    },
    "card": {
      "$value": "{ramp.neutral.2}"
    },
    "card-foreground": {
      "$value": "{color.foreground}"
    },
    "popover": {
      "$value": {
        "colorSpace": "oklch",
        "components": [1, 0, 0]
      },
      "$extensions": {
        "dev.hipuku.nimki": {
          "modes": {
            "dark": {
              "colorSpace": "oklch",
              "components": [0.21, 0.006, 260]
            }
          }
        }
      },
      "$description": "Off the ramp by decision: white in light, a raised dark in dark, as Radix Themes' panels"
    },
    "popover-foreground": {
      "$value": "{color.foreground}"
    },
    "primary": {
      "$value": "{ramp.neutral.12}"
    },
    "primary-foreground": {
      "$value": "{ramp.neutral.1}"
    },
    "secondary": {
      "$value": "{ramp.neutral.3}"
    },
    "secondary-foreground": {
      "$value": "{color.foreground}"
    },
    "muted": {
      "$value": "{ramp.neutral.3}"
    },
    "muted-foreground": {
      "$value": "{ramp.neutral.11}"
    },
    "accent": {
      "$value": "{ramp.neutral.4}"
    },
    "accent-foreground": {
      "$value": "{color.foreground}"
    },
    "destructive": {
      "$value": {
        "colorSpace": "oklch",
        "components": [0.58, 0.22, 27]
      },
      "$extensions": {
        "dev.hipuku.nimki": {
          "modes": {
            "dark": {
              "colorSpace": "oklch",
              "components": [0.65, 0.2, 25]
            }
          }
        }
      }
    },
    "border": {
      "$value": "{ramp.neutral.6}"
    },
    "input": {
      "$value": "{ramp.neutral.9}",
      "$description": "The edge that identifies a field: 3:1 against the background, card and popover (WCAG 2.2, 1.4.11). --border, for dividers, stays lighter"
    },
    "ring": {
      "$value": "{ramp.neutral.10}"
    }
  },
