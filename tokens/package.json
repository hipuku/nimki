{
  "name": "tokens",
  "private": true,
  "type": "module",
  "description": "nimki's DTCG token source and the generator that writes the CSS, the engine's token runtime and the Figma variables file",
  "scripts": {
    "write": "node src/cli.ts write",
    "check": "node src/cli.ts check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "figma:check": "node src/figma-cli.ts check",
    "figma:script": "node src/figma-cli.ts script",
    "figma:save": "node src/figma-cli.ts save",
    "figma:fresh": "node src/figma-cli.ts fresh",
    "figma:sync": "node src/figma-cli.ts sync",
    "figma:plugin": "node src/figma-cli.ts plugin",
    "figma:pull": "node src/figma-cli.ts pull",
    "figma:out": "node src/figma-cli.ts out",
    "figma:in": "node src/figma-cli.ts in"
  },
  "devDependencies": {
    "@hipuku/nimki": "workspace:^",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.1",
    "jsonc-parser": "^3.3.1",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
