{
  "name": "@hipuku/nimki",
  "version": "0.0.0",
  "description": "Motion engine for nimki components: duration caps, spring maths and motion hooks",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hipuku/nimki.git",
    "directory": "packages/engine"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:package": "publint --strict && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.1",
    "publint": "^0.3.25",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
