{
  "name": "nimki-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": "^22.18.0 || ^24.11.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:coverage": "pnpm -r run test:coverage",
    "lint": "eslint .",
    "lint:prose": "node scripts/check-prose.mjs",
    "lint:names": "node scripts/check-names.mjs",
    "lint:md": "markdownlint-cli2",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "check": "pnpm run lint:names && pnpm run build:engine && pnpm run tokens:check && pnpm run lint && pnpm run lint:prose && pnpm run lint:md && pnpm run knip && pnpm run format:check && pnpm run typecheck && pnpm run test:coverage && pnpm run build && pnpm --filter @hipuku/nimki run check:package && pnpm --filter @hipuku/nimki run size",
    "prepare": "git config core.hooksPath .githooks",
    "build:engine": "pnpm --filter @hipuku/nimki run build",
    "storybook": "pnpm --filter storybook run dev",
    "tokens:write": "pnpm --filter tokens run write",
    "tokens:check": "pnpm --filter tokens run check",
    "figma:check": "pnpm --filter tokens run figma:check",
    "figma:script": "pnpm --silent --filter tokens run figma:script",
    "figma:save": "pnpm --filter tokens run figma:save"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.6",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "knip": "^6.46.1",
    "markdownlint-cli2": "^0.24.1",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
