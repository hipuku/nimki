{
  "name": "docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "registry:build": "shadcn build --output public/r",
    "build": "pnpm run registry:build && next build",
    "start": "next start",
    "postinstall": "fumadocs-mdx",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:pages": "node scripts/check-pages.mjs"
  },
  "dependencies": {
    "@hipuku/nimki": "workspace:^",
    "fumadocs-core": "^16.19.6",
    "fumadocs-mdx": "^15.6.4",
    "lucide-react": "^1.77.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "playwright": "1.65.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
